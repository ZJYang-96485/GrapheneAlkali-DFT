! Restart continuation 2 for neutral Na on relaxed C50, central hollow site.
! All scientific settings match na_c50_hollow_20260924a_relax.in.
&CONTROL
   calculation = 'relax',
   restart_mode = 'restart',
   prefix = 'na_c50_hollow_20260924a_relax',
   pseudo_dir = './pseudopotentials',
   outdir = './qe_scratch/adsorption/na_c50_hollow_20260924a_relax',
   tstress = .true.,
   tprnfor = .true.,
   forc_conv_thr = 4.0d-4,
   max_seconds = 36000,
/
&SYSTEM
