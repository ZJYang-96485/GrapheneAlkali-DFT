! Production bare-substrate QE relaxation generated from an ASE structure.
! System: monovacancy
! Method: PBE-D3(BJ); dftd3_version=4 selects Becke-Johnson damping.
! Pseudopotential family: SSSP Efficiency PBE
! C1 distinguishes vacancy-adjacent C atoms while remaining DFT-D3-safe.
! Starting magnetizations are unconstrained initial seeds only.
! Approved symmetry-breaking seed: vacancy neighbor 1 shifted +0.01 angstrom along x toward neighbor 2.
! QE symmetry remains enabled; a startup symmetry audit is required before continuation.

&CONTROL
   calculation = 'relax',
   prefix = 'graphene_monovacancy_relax_65_520_cg_seed001_c1_20260917',
   pseudo_dir = './pseudopotentials',
   outdir = './qe_scratch/relaxation/monovacancy_65_520_cg_seed001_c1_20260917',
   tstress = .true.,
   tprnfor = .true.,
   forc_conv_thr = 4.0d-4,
/

&SYSTEM
   ibrav = 0,
   nat = 49,
   ntyp = 2,
   input_dft = 'PBE',
   vdw_corr = 'dft-d3',
   dftd3_version = 4,
   dftd3_threebody = .true.,
   assume_isolated = '2D',
   ecutwfc = 65,
   ecutrho = 520,
   nspin = 2,
   occupations = 'smearing',
   smearing = 'mv',
   degauss = 0.01,
   starting_magnetization(1) = 0,
   starting_magnetization(2) = 0.1,
/

&ELECTRONS
   conv_thr = 1.0d-8,
   mixing_beta = 0.3,
   diagonalization = 'cg',
/

&IONS
   ion_dynamics = 'bfgs',
/

ATOMIC_SPECIES
C   12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF
C1  12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF

