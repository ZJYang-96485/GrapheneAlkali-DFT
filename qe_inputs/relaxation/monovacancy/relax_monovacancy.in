! Production bare-substrate QE relaxation generated from an ASE structure.
! System: monovacancy
! Method: PBE-D3(BJ); dftd3_version=4 selects Becke-Johnson damping.
! Pseudopotential family: SSSP Efficiency PBE
! C_v is the QE-valid (3-character) label for vacancy-adjacent C atoms.
! Starting magnetizations are unconstrained initial seeds only.

&CONTROL
   calculation = 'relax',
   prefix = 'graphene_monovacancy',
   pseudo_dir = './pseudopotentials',
   outdir = './qe_scratch/monovacancy',
   tstress = .true.,
   tprnfor = .true.,
   forc_conv_thr = 4.0d-4,
/

&SYSTEM
   ibrav = 0,
   nat = 49,
   ntyp = 2,
   input_dft = 'PBE',
   vdw_corr = 'dft-d3',
   dftd3_version = 4,
   dftd3_threebody = .true.,
   assume_isolated = '2D',
   ecutwfc = 50,
   ecutrho = 400,
   nspin = 2,
   occupations = 'smearing',
   smearing = 'mv',
   degauss = 0.01,
   starting_magnetization(1) = 0,
   starting_magnetization(2) = 0.1,
/

&ELECTRONS
   conv_thr = 1.0d-8,
   mixing_beta = 0.3,
/

&IONS
   ion_dynamics = 'bfgs',
/

ATOMIC_SPECIES
C   12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF
C_v 12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
  12.30000000  0.00000000  0.00000000
  -6.15000000  10.65211247  0.00000000
  0.00000000  0.00000000  18.00000000

