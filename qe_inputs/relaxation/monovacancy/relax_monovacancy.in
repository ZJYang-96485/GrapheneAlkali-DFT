! Bare-substrate QE relaxation template generated from an ASE structure.
! System: monovacancy
! Replace every __QE_UNRESOLVED__ value before running pw.x.
! pseudopotential_family = __QE_UNRESOLVED__

&CONTROL
   calculation = 'relax',
   prefix = 'graphene_monovacancy',
   pseudo_dir = './pseudopotentials',
   outdir = './qe_scratch/monovacancy',
   tstress = .true.,
   tprnfor = .true.,
   forc_conv_thr = __QE_UNRESOLVED__,
/

&SYSTEM
   ibrav = 0,
   nat = 49,
   ntyp = 1,
   input_dft = '__QE_UNRESOLVED__',
   ecutwfc = __QE_UNRESOLVED__,
   ecutrho = __QE_UNRESOLVED__,
   nspin = 2,
   occupations = '__QE_UNRESOLVED__',
   starting_magnetization(1) = __QE_UNRESOLVED__,
   smearing = '__QE_UNRESOLVED__',
   degauss = __QE_UNRESOLVED__,
/

&ELECTRONS
   conv_thr = __QE_UNRESOLVED__,
   mixing_beta = __QE_UNRESOLVED__,
/

ATOMIC_SPECIES
C  12.011  __QE_UNRESOLVED__

