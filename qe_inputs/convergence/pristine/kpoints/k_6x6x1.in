! Phase 4 fixed-geometry pristine C50 convergence calculation.
! Study: kpoints; point: k_6x6x1
! Method held fixed: PBE-D3(BJ), 2D Coulomb isolation, approved SSSP carbon PAW.

&CONTROL
   calculation = 'scf',
   restart_mode = 'from_scratch',
   prefix = 'c50_conv_kpoints_k_6x6x1',
   pseudo_dir = './pseudopotentials',
   outdir = './qe_scratch/convergence/pristine/kpoints/k_6x6x1',
/

&SYSTEM
   ibrav = 0,
   nat = 50,
   ntyp = 1,
   input_dft = 'PBE',
   vdw_corr = 'dft-d3',
   dftd3_version = 4,
   dftd3_threebody = .true.,
   assume_isolated = '2D',
   ecutwfc = 65,
   ecutrho = 520,
   nspin = 1,
   occupations = 'smearing',
   smearing = 'mv',
   degauss = 0.01,
/

&ELECTRONS
   conv_thr = 1.0d-8,
   mixing_beta = 0.3,
   diagonalization = 'cg',
/

ATOMIC_SPECIES
C   12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
  12.30000000  0.00000000  0.00000000
  -6.15000000  10.65211247  0.00000000
  0.00000000  0.00000000  18.00000000

