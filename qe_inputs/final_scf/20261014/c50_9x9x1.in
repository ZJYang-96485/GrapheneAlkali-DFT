! Fixed-geometry final SCF built from a strictly accepted relaxation.
! PBE, DFT-D3(BJ), 65/520 Ry, MV smearing 0.01 Ry, CG, and spin settings inherited.
! Production bare-substrate QE relaxation generated from an ASE structure.
! System: pristine
! Method: PBE-D3(BJ); dftd3_version=4 selects Becke-Johnson damping.
! Pseudopotential family: SSSP Efficiency PBE

&CONTROL
   calculation = 'scf',
   prefix = 'final9_c50_20261014',
   pseudo_dir = './pseudopotentials',
   outdir = './qe_scratch/final_scf/final9_c50_20261014',
   tstress = .true.,
   tprnfor = .true.,
/   restart_mode = 'from_scratch',
   disk_io = 'nowf',
   max_seconds = 14400,
/
&SYSTEM
   ibrav = 0,
   nat = 50,
   ntyp = 1,
   input_dft = 'PBE',
   vdw_corr = 'dft-d3',
   dftd3_version = 4,
   dftd3_threebody = .true.,
   assume_isolated = '2D',
   ecutwfc = 65,
   ecutrho = 520,
   nspin = 1,
   occupations = 'smearing',
   smearing = 'mv',
   degauss = 0.01,
/

&ELECTRONS
   conv_thr = 1.0d-8,
   mixing_beta = 0.3,
   diagonalization = 'cg',
/

ATOMIC_SPECIES
C   12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF

