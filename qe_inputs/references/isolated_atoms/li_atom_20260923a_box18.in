! Neutral isolated Li-atom reference pilot in an 18 Angstrom cubic box.
! This is a spin/box-method check, not yet the final adsorption-energy reference.
! Method and literature: docs/PHASE5_ISOLATED_ATOM_REFERENCE_PLAN.md
&CONTROL
   calculation = 'scf',
   prefix = 'li_atom_20260923a_box18',
   pseudo_dir = './pseudopotentials',
   outdir = './qe_scratch/references/li_atom_20260923a_box18',
   tstress = .false.,
   tprnfor = .true.,
   max_seconds = 3000,
/
&SYSTEM
   ibrav = 0,
   nat = 1,
   ntyp = 1,
   tot_charge = 0.0,
   input_dft = 'PBE',
   vdw_corr = 'dft-d3',
   dftd3_version = 4,
   dftd3_threebody = .true.,
   assume_isolated = 'mt',
   ecutwfc = 65,
   ecutrho = 520,
   nspin = 2,
   tot_magnetization = 1.0,
   occupations = 'fixed',
/
&ELECTRONS
   conv_thr = 1.0d-8,
   mixing_beta = 0.3,
   diagonalization = 'cg',
/

ATOMIC_SPECIES
Li 6.94 li_pbe_v1.4.uspp.F.UPF

CELL_PARAMETERS angstrom
18.0  0.0  0.0
 0.0 18.0  0.0
 0.0  0.0 18.0

ATOMIC_POSITIONS angstrom
Li 9.0 9.0 9.0

K_POINTS gamma
