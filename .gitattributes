* text=auto

# Reproducible Linux/WSL scripts and scientific text inputs/outputs.
*.sh text eol=lf
*.py text eol=lf
*.in text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.xyz text eol=lf
*.out text eol=lf -whitespace

# Generated binary artifacts.
*.png binary
*.traj binary
